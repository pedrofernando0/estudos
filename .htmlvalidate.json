{
  "extends": ["html-validate:standard"],
  "rules": {
    "no-trailing-whitespace": "off",
    "no-inline-style": "off",
    "prefer-native-element": "off",
    "attribute-boolean-style": "off",
    "long-size": "off",
    "heading-level": "off",
    "no-redundant-role": "warn",
    "element-permitted-content": "warn",
    "wcag/h32": "off",
    "wcag/h37": "off"
  }
}
